{
	"dependencies": {
		"@bandwidth-saver/shared": "workspace:*",
		"@cf-wasm/minify-html": "^0.1.3",
		"@elysiajs/eden": "^1.4.6",
		"dotenv": "^17.2.3",
		"elysia": "latest",
		"sharp": "^0.34.5",
		"valibot": "^1.1.0",
		"wasm-image-optimization": "^1.4.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.13"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"module": "src/index.ts",
	"name": "@bandwidth-saver/proxy",
	"scripts": {
		"build": "bun build src/index.ts --outdir .output --target=bun --env=inline",
		"build:cloudflare": "DEPLOYMENT_PLATFORM=cloudflare bun run build",
		"dev": "DEPLOYMENT_PLATFORM=server bun run --watch src/index.ts",
		"dev:cloudflare": "DEPLOYMENT_PLATFORM=cloudflare wrangler dev",
		"format": "biome format ./ --write",
		"gen-types:cloudflare": "wrangler types",
		"lint": "biome lint ./ --write",
		"start": "bun run src/index.ts",
		"test": "bun test"
	},
	"type": "module",
	"version": "1.0.50"
}
