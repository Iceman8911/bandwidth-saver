{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bandwidth-saver",
	"main": "src/index.ts",
	"compatibility_date": "2026-02-02",
	"compatibility_flags": [
    "nodejs_compat"
  ],
  "dev": {
      "port": 8787,
      "local_protocol": "http",
      "ip": "127.0.0.1"
    },
  "vars": {
    "DEPLOYMENT_PLATFORM": "cloudflare"
  },
  "preview_urls": true,
  "workers_dev": true,
  "observability": {
      "enabled": false,
      "head_sampling_rate": 1,
      "logs": {
        "enabled": true,
        "head_sampling_rate": 1,
        "persist": true,
        "invocation_logs": true
      },
      "traces": {
        "enabled": false,
        "persist": true,
        "head_sampling_rate": 1
      }
    }
}
