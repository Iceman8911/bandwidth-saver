{
	"dependencies": {
		"@bandwidth-saver/shared": "workspace:*",
		"@elysiajs/eden": "^1.4.8",
		"@kobalte/core": "^0.13.11",
		"@kobalte/tailwindcss": "^0.9.0",
		"@solidjs/router": "^0.15.4",
		"@ver0/deep-equal": "^2.0.1",
		"@webext-core/messaging": "^2.3.0",
		"chartist": "^1.5.0",
		"immer": "^11.1.4",
		"lucide-solid": "^0.577.0",
		"query-selector-shadow-dom": "^1.0.1",
		"solid-js": "^1.9.11",
		"solidjs-use": "^2.3.0",
		"tiny-lru": "^11.4.7",
		"valibot": "^1.2.0"
	},
	"description": "bandwidth-saver-and-monitor",
	"devDependencies": {
		"@bandwidth-saver/proxy": "workspace:*",
		"@biomejs/biome": "^2.4.6",
		"@iceman8911/unplugin-inline-enum": "^0.6.7",
		"@playwright/test": "^1.58.2",
		"@tailwindcss/vite": "^4.2.1",
		"@types/query-selector-shadow-dom": "^1.0.4",
		"@types/webextension-polyfill": "^0.12.5",
		"@wxt-dev/auto-icons": "^1.1.1",
		"@wxt-dev/module-solid": "^1.1.4",
		"daisyui": "^5.5.19",
		"tailwind-scrollbar": "^4.0.2",
		"tailwindcss": "^4.2.1",
		"type-fest": "^5.4.4",
		"typescript": "^5.9.3",
		"vite-plugin-lucide-preprocess": "^1.4.7",
		"vitest": "^4.0.18",
		"wxt": "^0.20.18"
	},
	"name": "bandwidth-saver-and-monitor",
	"private": true,
	"scripts": {
		"build": "bun --bun run build:chromium & bun --bun run build:firefox",
		"build:chromium": "wxt zip --mv3",
		"build:firefox": "wxt zip -b firefox --mv3",
		"compile": "tsc --noEmit",
		"dev": "bun run dev:chromium",
		"dev:chromium": "wxt",
		"dev:firefox": "wxt -b firefox",
		"format": "biome format ./ --write",
		"lint": "biome lint ./ --write",
		"start": "echo 'No start command for extension'",
		"test": "vitest"
	},
	"trustedDependencies": [
		"spawn-sync"
	],
	"type": "module",
	"version": "0.0.1"
}
