{
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"husky": "^9.1.7",
		"lint-staged": "^16.3.2",
		"turbo": "^2.8.14"
	},
	"lint-staged": {
		"*.{js,ts,jsx,tsx,json,css}": [
			"biome check --write"
		]
	},
	"name": "bandwidth-saver-monorepo",
	"packageManager": "bun@1.3.6",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"format": "turbo run format",
		"lint": "turbo run lint",
		"prepare": "husky",
		"start": "turbo run start",
		"test": "turbo run test"
	},
	"trustedDependencies": [
		"esbuild",
		"sharp",
		"workerd"
	],
	"workspaces": [
		"packages/*",
		"apps/*"
	]
}
